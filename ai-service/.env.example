# local → FastAPI HTTP server on :8000, Spring Boot calls directly
# production → Lambda container, triggered by SQS
APP_ENV=local

# S3 is the ONLY AWS service used locally.
# 1. Create S3 bucket (private)
# 2. Create IAM user with inline policy: s3:GetObject, s3:PutObject, s3:HeadObject on bucket
# 3. Create access key, paste below
# Never use root credentials.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=clair-tax-receipts-dev

BACKEND_API_BASE_URL=http://localhost:8080
BACKEND_INTERNAL_TOKEN=

EASYOCR_GPU=false
EASYOCR_MODEL_DIR=/tmp/easyocr_models

DEFAULT_RECEIPT_CURRENCY=MYR
TRAINED_RECEIPT_POSTPROCESSOR_ENABLED=false
TRAINED_RECEIPT_POSTPROCESSOR_ARTIFACT_PATH=./model_artifacts/receipt_postprocessor.joblib
RECEIPT_AMOUNT_SELECTION_THRESHOLD=0.5
RECEIPT_DATE_SELECTION_THRESHOLD=0.4
RECEIPT_VALIDITY_THRESHOLD=0.3

LOG_LEVEL=INFO
